# Required: secret for signing JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Required for `npm run seed`: MongoDB connection string used by the seed script.
MONGODB_URI=mongodb://localhost:27017/handmade-shop

# Optional: "production" makes the auth cookie HTTPS-only (secure flag).
NODE_ENV=development
